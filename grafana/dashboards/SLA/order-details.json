          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH base AS (\r\n  SELECT\r\n    order_id,\r\n    order_type,\r\n    order_created_ts,\r\n    breach_scope,\r\n    ship_method,\r\n    route_type,\r\n\r\n    CASE\r\n      WHEN '${sla_stage}' = 'PICK'\r\n        THEN pick_breach_state\r\n      WHEN '${sla_stage}' = 'STAGE_STARTED'\r\n        THEN stage_started_breach_state\r\n      WHEN '${sla_stage}' = 'STAGE_COMPLETED'\r\n        THEN stage_complete_breach_state\r\n      WHEN '${sla_stage}' = 'SHIP'\r\n        THEN ship_breach_state\r\n    END AS status\r\n\r\n  FROM order_sla_breach_reporting\r\n  WHERE\r\n    ('${order_type:regex}' = '.*' OR order_type ~ '${order_type:regex}')\r\n    AND ('${order_id}' = '' OR order_id::text = '${order_id}')\r\n    AND $__timeFilter(order_created_ts)\r\n)\r\n\r\nSELECT\r\n  order_id,\r\n  order_type,\r\n  status,\r\n  order_created_ts,\r\n  breach_scope,\r\n  ship_method,\r\n  route_type\r\nFROM base\r\nWHERE\r\n  '${sla_status:regex}' = '.*'\r\n  OR status = '${sla_status:regex}'\r\nORDER BY order_created_ts DESC;\r\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
