        {
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH stages AS (\r\n  SELECT\r\n    order_id,\r\n    'PICK' AS stage,\r\n    pick_start_ts AS start_ts,\r\n    COALESCE(pick_complete_ts, now()) AS end_ts,\r\n    pick_sla_minutes AS sla_target\r\n  FROM order_sla_evaluation\r\n  WHERE ('${order_id}' = '' OR order_id::text = '${order_id}')\r\n\r\n  UNION ALL\r\n\r\n  SELECT\r\n    order_id,\r\n    'STAGE_STARTED',\r\n    pick_complete_ts,\r\n    COALESCE(stage_start_ts, now()),\r\n    stage_sla_minutes\r\n  FROM order_sla_evaluation\r\n  WHERE ('${order_id}' = '' OR order_id::text = '${order_id}')\r\n\r\n  UNION ALL\r\n\r\n  SELECT\r\n    order_id,\r\n    'STAGE_COMPLETED',\r\n    stage_start_ts,\r\n    COALESCE(stage_complete_ts, now()),\r\n    stage_complete_sla_minutes\r\n  FROM order_sla_evaluation\r\n  WHERE ('${order_id}' = '' OR order_id::text = '${order_id}')\r\n\r\n  UNION ALL\r\n\r\n  SELECT\r\n    order_id,\r\n    'SHIP',\r\n    stage_complete_ts,\r\n    COALESCE(ship_ts, now()),\r\n    ship_sla_minutes\r\n  FROM order_sla_evaluation\r\n  WHERE ('${order_id}' = '' OR order_id::text = '${order_id}')\r\n)\r\n\r\nSELECT\r\n  stage AS state,\r\n  start_ts AS time,\r\n  end_ts AS time_end,\r\n  ROUND(EXTRACT(EPOCH FROM (end_ts - start_ts)) / 60, 1) AS duration_min,\r\n  sla_target,\r\n  ROUND(\r\n    (EXTRACT(EPOCH FROM (end_ts - start_ts)) / 60)\r\n    / NULLIF(sla_target, 0) * 100,\r\n    1\r\n  ) AS sla_progress_pct,\r\n  CASE\r\n    WHEN EXTRACT(EPOCH FROM (end_ts - start_ts)) / 60 >= sla_target THEN 'Delayed'\r\n    WHEN EXTRACT(EPOCH FROM (end_ts - start_ts)) / 60 >= sla_target * 0.25 THEN 'Moving Slow'\r\n    ELSE 'OK'\r\n  END AS sla_status\r\nFROM stages\r\nWHERE start_ts IS NOT NULL\r\nORDER BY time ASC;   -- ✅ THIS LINE FIXES THE ERROR\r\n",
          "refId": "A",
          "sql": {
